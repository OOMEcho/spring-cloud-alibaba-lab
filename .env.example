# 本文件供参考；复制为 .env 后填写，本项目不会自动加载 .env。
# macOS 终端可执行 set -a; source .env; set +a，再启动 Java 服务。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
# Nacos 启用客户端鉴权时填写账号密码；未启用时保持空值。
# public 命名空间保持空值；其他命名空间填 ID，不是显示名称。
NACOS_NAMESPACE=
NACOS_GROUP=LAB_GROUP

# Sentinel Dashboard 位于 OrbStack，业务服务在 macOS 上运行。
SENTINEL_DASHBOARD=127.0.0.1:8858
SENTINEL_CLIENT_PORT=8719
# 留空时 SDK 自动选择本机 IP；需要手动指定时填 Dashboard 可达的数字 IP，不能填域名。
SENTINEL_CLIENT_IP=
# 以下为 Sentinel Dashboard 登录凭据，不是业务接口认证配置。
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=sentinel

# 复用已有 MySQL 时填写项目专用账号；独立 Compose 环境参考 .env.compose.example。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your-project-account
DB_PASSWORD=your-project-password
# DB_SCHEMA 可在单个服务运行配置中覆盖，不要给全部服务设置同一个 DB_SCHEMA。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DATABASE=0
REDIS_CACHE_PREFIX=cloud-lab:

# RabbitMQ 使用项目专用 vhost 和账号。
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=your-project-rabbit-account
RABBIT_PASSWORD=your-project-rabbit-password
RABBIT_VHOST=/cloud-lab

# 订单/库存使用 Seata TC，其他服务不需要这些参数。
SEATA_ENABLED=true
# Seata 通过 Nacos 发现 TC；以下值与服务端注册信息对应。
# Nacos 地址和鉴权沿用 NACOS_SERVER_ADDR / NACOS_USERNAME / NACOS_PASSWORD。
SEATA_NACOS_APPLICATION=seata-server
SEATA_NACOS_GROUP=SEATA_GROUP
# public 使用空 ID；与业务服务的 NACOS_NAMESPACE 独立设置。
SEATA_NACOS_NAMESPACE=
SEATA_NACOS_CLUSTER=default
