# 独立 Compose 环境模板；复制为 .env.compose，填写后执行 --env-file .env.compose。
# 以下占位密码必须替换；MySQL 初始化账号密码只允许字母、数字、_、-。
# 可以用 openssl rand -hex 24 分别生成密码。
MYSQL_ROOT_PASSWORD=replace_mysql_root_password
DB_USERNAME=cloud_lab
DB_PASSWORD=replace_business_password
SEATA_DB_PASSWORD=replace_seata_password
REDIS_PASSWORD=replace_redis_password
RABBIT_USERNAME=cloud_lab
RABBIT_PASSWORD=replace_rabbit_password
RABBIT_VHOST=/cloud-lab
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace_nacos_password
# JWT 密钥：使用 openssl rand -base64 48 生成，不使用固定公共密钥。
NACOS_AUTH_TOKEN=replace_with_base64_secret
NACOS_AUTH_IDENTITY_VALUE=replace_nacos_identity
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=replace_sentinel_password

# Java 在宿主机运行，默认映射避开已有中间件端口。
DB_HOST=127.0.0.1
DB_PORT=13306
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DATABASE=0
REDIS_CACHE_PREFIX=cloud-lab:
RABBIT_HOST=127.0.0.1
RABBIT_PORT=15673
RABBIT_MANAGEMENT_PORT=25672
NACOS_API_PORT=18848
NACOS_GRPC_PORT=19848
NACOS_CONSOLE_PORT=18080
NACOS_SERVER_ADDR=127.0.0.1:18848
NACOS_NAMESPACE=
NACOS_GROUP=LAB_GROUP
SENTINEL_DASHBOARD_PORT=18858
SENTINEL_DASHBOARD=127.0.0.1:18858
SENTINEL_CLIENT_PORT=8719
# 填 Dashboard 容器能访问的宿主机数字 IP，不能填 host.docker.internal 域名。
SENTINEL_CLIENT_IP=
SEATA_ENABLED=true
SEATA_PORT=18091
# 仅示例：替换为当前宿主机实际 IPv4；不能用 127.0.0.1 或 0.0.0.0。
# Compose 的 TC 端口绑定到该地址，客户端通过 Nacos 获取同一地址。
SEATA_ADVERTISED_IP=192.0.2.1
# Seata 通过 Nacos 发现 TC；以下值与服务端注册信息对应。
# Nacos 地址和鉴权沿用 NACOS_SERVER_ADDR / NACOS_USERNAME / NACOS_PASSWORD。
SEATA_NACOS_APPLICATION=seata-server
SEATA_NACOS_GROUP=SEATA_GROUP
# public 使用空 ID；与业务服务的 NACOS_NAMESPACE 独立设置。
SEATA_NACOS_NAMESPACE=
SEATA_NACOS_CLUSTER=default
